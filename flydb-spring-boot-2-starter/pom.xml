<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flydb</groupId>
        <artifactId>flydb-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <!--
        flydb-spring-boot-2-starter：Spring Boot 2.7.x / Java 8。
        阶段 7 实现：spring.factories、FlydbAutoConfiguration、FlydbMigrationInitializer、SLF4J 桥接。
    -->
    <artifactId>flydb-spring-boot-2-starter</artifactId>
    <packaging>jar</packaging>

    <name>Flydb :: Spring Boot 2 Starter</name>

    <dependencies>
        <dependency>
            <groupId>com.flydb</groupId>
            <artifactId>flydb-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <version>${spring-boot-2.version}</version>
        </dependency>
        <!-- Boot 2.7 的依赖管理将 HikariCP 4 自带的 SLF4J 2 alpha 对齐到 1.7；
             starter 自身显式保持这一约束，避免未继承 Spring Boot BOM 的应用发生日志绑定冲突。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-1.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot-2.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <version>${spring-boot-2.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <version>${spring-boot-2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
